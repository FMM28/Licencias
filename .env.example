# Copia a .env y ajusta. Nunca subas .env ni la clave privada al repositorio.

# --- Base de datos -------------------------------------------------------------
# Obligatoria. Solo MariaDB (10.6+). En desarrollo: `make db-up` y la URL de abajo.
LICENSE_DB_URL=mariadb+pymysql://lic:CAMBIA_ESTA_CLAVE@127.0.0.1:3306/licenses
# Desarrollo (docker-compose.dev.yml):
# LICENSE_DB_URL=mariadb+pymysql://lic:lic_dev_pass@127.0.0.1:3306/licenses
# true = aplica migraciones al arrancar; en producción déjalo en false y corre `python -m app.cli db upgrade`
LICENSE_AUTO_MIGRATE=false

# --- Firma de licencias ----------------------------------------------------------
LICENSE_PRIVATE_KEY_FILE=keys/private.key
# o bien, en vez del archivo (semilla base64 que imprime `python -m app.cli init`):
# LICENSE_PRIVATE_KEY=
LICENSE_TOKEN_TTL_DAYS=7        # gracia offline y frecuencia mínima de validación
LICENSE_EXPIRY_GRACE_DAYS=3     # tolerancia tras vencer una suscripción
LICENSE_RATE_LIMIT=30           # peticiones/minuto por IP en /v1

# --- Panel de administración -------------------------------------------------------
LICENSE_COOKIE_SECURE=true      # false SOLO si pruebas por http://localhost
LICENSE_SESSION_IDLE_MINUTES=60
LICENSE_SESSION_MAX_HOURS=12
LICENSE_LOGIN_RATE_LIMIT=10     # intentos/minuto por IP
LICENSE_LOGIN_MAX_FAILURES=5    # fallos antes de bloquear la cuenta
LICENSE_LOGIN_LOCK_MINUTES=15
LICENSE_ENABLE_DOCS=false       # true expone /docs y /openapi.json

# --- Tunnel de Cloudflare ----------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=